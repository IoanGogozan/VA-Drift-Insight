va.norvix.no {
	encode zstd gzip

	log {
		output file /data/logs/va-drift-insight-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format json
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy va-drift-api:3001
	}

	handle {
		reverse_proxy va-drift-web:3000
	}
}
